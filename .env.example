NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_LANGUAGE=pt
# Gemini (alternativa ao Claude + Whisper; troque no seletor do app).
# Atenção: no plano GRATUITO o Google pode usar o conteúdo para melhorar os produtos dele.
# Para dados de trabalho, use só com faturamento ativo (plano pago) ou deixe vazio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Padrão quando o seletor nunca foi usado: claude ou gemini
AI_PROVIDER=
# Só estes e-mails entram no app (separados por vírgula). Vazio = qualquer conta criada.
ALLOWED_EMAILS=
# Notificações diárias (Web Push). Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# O resumo diário roda sem usuário logado: precisa da chave service_role (Project Settings → API)
SUPABASE_SERVICE_ROLE_KEY=
# Qualquer texto longo; a Vercel manda no cron e a rota confere
CRON_SECRET=
